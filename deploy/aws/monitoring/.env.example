# ======================================================
# Alertmanager Environment Configuration
# Copy this file to .env and fill in your actual values
# ======================================================

# ===== SMTP Configuration (for email alerts) =====
# Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=alerts@brightnest-academy.com
SMTP_USERNAME=your-gmail@gmail.com
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=your-app-password-here

# ===== Notification Recipients =====
OPS_EMAIL=ops@brightnest-academy.com
DB_ADMIN_EMAIL=dba@brightnest-academy.com

# ===== Slack Integration (optional) =====
# Create incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===== SMS Notifications via Twilio (optional) =====
# Twilio webhook for critical alerts (requires Twilio Function setup)
TWILIO_WEBHOOK_URL=https://your-twilio-function.twil.io/alert

# ===== Grafana Configuration =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-strong-password

# ===== Database Connection (for mysqld_exporter) =====
DB_HOST=mysql
DB_PORT=3306
DB_NAME=shrishail_academy
DB_USER=monitoring_user
DB_PASS=monitoring_password

# ===== Redis Connection (for redis_exporter) =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ======================================================
# SETUP INSTRUCTIONS
# ======================================================
#
# 1. Gmail SMTP Setup:
#    - Enable 2-factor authentication on your Google account
#    - Generate App Password: https://myaccount.google.com/apppasswords
#    - Use the 16-character app password as SMTP_PASSWORD
#
# 2. Slack Webhook Setup:
#    - Go to https://api.slack.com/apps
#    - Create new app → Incoming Webhooks → Add to Workspace
#    - Copy webhook URL and paste as SLACK_WEBHOOK_URL
#    - Create channels: #alerts and #critical-alerts
#
# 3. Database Monitoring User:
#    CREATE USER 'monitoring_user'@'%' IDENTIFIED BY 'monitoring_password';
#    GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'monitoring_user'@'%';
#    FLUSH PRIVILEGES;
#
# 4. Test Alertmanager:
#    docker compose -f docker-compose.monitoring.yml up alertmanager
#    Check logs: docker logs alertmanager
#    Send test alert: curl -X POST http://localhost:9093/api/v1/alerts
#
# ======================================================
