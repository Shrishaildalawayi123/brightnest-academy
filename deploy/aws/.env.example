# BrightNest Academy deployment environment example
# Copy this to /opt/brightnest/.env on EC2 and replace placeholder values.

GITHUB_REPOSITORY_OWNER=your-github-username-or-org

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brightnest
DB_USER=brightnest
DB_PASS=change-me

JWT_SECRET=change-me-to-a-strong-random-secret
JWT_REFRESH_PEPPER=change-me-refresh-pepper

ADMIN_EMAIL=admin@brightnest-academy.com
ADMIN_PASSWORD=change-me
ADMIN_NOTIFY_EMAIL=info@brightnest-academy.com

RATE_LIMIT_BACKEND=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=5000
REDIS_CONNECT_TIMEOUT=2000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

COOKIE_SECURE=true
COOKIE_SAMESITE=None
HTTPS_REQUIRED=true
