RESUME_STORAGE_S3_ENABLED=true
RESUME_STORAGE_S3_BUCKET=
RESUME_STORAGE_S3_REGION=ap-south-1
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=8080
SPRING_PROFILES_ACTIVE=prod
