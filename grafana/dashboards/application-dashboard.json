        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri)) * 1000",
          "legendFormat": "p95 - {{uri}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri)) * 1000",
          "legendFormat": "p99 - {{uri}}",
          "refId": "B"
        }
      ],
      "title": "HTTP Response Time (p95, p99)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
