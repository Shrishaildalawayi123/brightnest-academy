{
  // Keep VS Code Java tooling aligned with Maven's required JDK (21).
  "java.jdt.ls.java.home": "C:\\Users\\Dell\\.jdk\\jdk-21.0.1+12",

  // Force Java project language/runtime level to Java 21 in this workspace.
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "C:\\Users\\Dell\\.jdk\\jdk-21.0.1+12",
      "default": true
    }
  ],

  // Keep Maven/Java imports on the same JDK to prevent mixed-compiler indexing noise.
  "java.import.maven.java.home": "C:\\Users\\Dell\\.jdk\\jdk-21.0.1+12",

  // Null Analysis - Reduce false positive warnings for Spring/JUnit framework methods
  "java.compile.nullAnalysis.mode": "automatic",
  "java.compile.nullAnalysis.nonnull": [],
  "java.compile.nullAnalysis.nullable": [],

  // Code Quality
  "java.format.enabled": true,
  "java.saveActions.organizeImports": true,

  "chat.tools.terminal.autoApprove": {
    "Start-Process": true
  }
}
